[Unit]
Description=MixWithMe Next.js frontend
After=network.target mixwithme-api.service

[Service]
User=mixwithme
Group=mixwithme
WorkingDirectory=/opt/mixwithme/current/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/mixwithme/current/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/mixwithme
MemoryMax=1024M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
