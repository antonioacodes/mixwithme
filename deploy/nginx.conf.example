# Add inside nginx http {} (e.g. /etc/nginx/conf.d/mixwithme-limits.conf).
limit_req_zone $binary_remote_addr zone=mixwithme:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=mixwithme_conn:10m;

